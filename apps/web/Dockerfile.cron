# Recovery cron: checks MySQL for pending work and calls Cap Web only when
# needed, so a sleeping Cap Web stays asleep. Runs on Railway's cron schedule.
FROM alpine:3.20
RUN apk add --no-cache mariadb-client mariadb-connector-c curl
ADD --checksum=sha256:d46e1bdfda05c8e7644e50930806a19b139a222542bf0348082fb59ece2b5fa5 https://truststore.pki.rds.amazonaws.com/us-east-2/us-east-2-bundle.pem /etc/ssl/rds/us-east-2-bundle.pem
RUN chmod 0755 /etc/ssl/rds && chmod 0444 /etc/ssl/rds/us-east-2-bundle.pem
COPY apps/web/scripts/cron-check.sh /cron-check.sh
RUN chmod +x /cron-check.sh
CMD ["/cron-check.sh"]
